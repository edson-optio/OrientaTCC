PORT=3000
DATABASE_URL=./data/orientatcc.db

# Notificações (Resend). Sem RESEND_API_KEY os e-mails são apenas logados no console.
RESEND_API_KEY=
RESEND_FROM=OrientaTCC <onboarding@resend.dev>

# Autenticação (Better Auth). Gere o segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Monitor de prazos: expressao cron (padrao 0 7 * * *, America/Sao_Paulo) ou off
MONITOR_PRAZOS_CRON=
